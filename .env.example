# Salin menjadi .env (JANGAN di-commit). Untuk deploy, isi di
# Vercel → Project → Settings → Environment Variables.

# Secret endpoint /api/tick dan /api/kontrol
CRON_SECRET=ganti-dengan-string-acak-panjang

# Upstash Redis (Vercel Marketplace → Storage → Upstash for Redis, plan gratis)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Kill switch tanpa deploy ulang (1/true = blokir order baru)
KILL_SWITCH=0

# Opsional: paksa penyimpanan lokal (hanya untuk uji di laptop)
# STORE=file
# LOCAL_STORE_DIR=local_state

# Untuk GitHub Actions (bukan untuk aplikasi):
# VERCEL_URL=https://nama-app.vercel.app
